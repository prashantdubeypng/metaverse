# Server Configuration
HTTP_SERVICE_PORT=8000
NODE_ENV=development

# Database
DATABASE_URL="postgresql://user:password@localhost:5432/metaverse?schema=public"

# JWT Configuration
JWT_SECRET=your-super-secret-jwt-key-change-in-production-min-32-chars
ACCESS_TOKEN_EXPIRES=15m
REFRESH_TOKEN_EXPIRES_DAYS=30

# Password Hashing
BCRYPT_SALT_ROUNDS=12

# Redis Configuration
# Development (no password)
REDIS_URL=redis://localhost:6379
# Production (with password)
# REDIS_URL=redis://:redispassword@localhost:6379

# Rate Limiting
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=30

# Account Security
MAX_FAILED_ATTEMPTS=5
LOCK_DURATION_MINUTES=15

# Cookie Configuration (for production)
COOKIE_DOMAIN=

# Frontend URL
FRONTEND_URL=http://localhost:3000

# Password Reset Configuration
RESET_TOKEN_BYTES=32
RESET_TOKEN_EXPIRES_MIN=60
RESET_RATE_LIMIT_WINDOW_MS=60000
RESET_RATE_LIMIT_MAX_PER_IP=5
RESET_RATE_LIMIT_MAX_PER_EMAIL=3
